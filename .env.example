# Copy to .env. Never commit .env.

# --- Target application credentials -------------------------------------
# The CoreBank demo app accepts any user id with this password.
# Artifacts reference it only as {"secret_ref": "APP_PASSWORD"} — never inline.
APP_USER=svc_agent
APP_PASSWORD=demo1234

# Flask session signing key for the demo app.
APP_SECRET_KEY=dev-only-not-a-real-secret

# --- Discovery LLM (Phase 5 only) ---------------------------------------
# Everything except discovery runs with no API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
