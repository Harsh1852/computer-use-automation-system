{
  "schema_version": "1.0",
  "id": "drifted_locator",
  "version": "1.0.0",
  "title": "Balance lookup whose SEARCH locator has drifted",
  "description": "Identical to lookup_member_balance except that step s6 was recorded against a button named FIND MEMBER, which this build of the product no longer has. Exists to exercise the bounded assisted fallback on a genuine TARGET_NOT_FOUND.",
  "approval": {
    "state": "draft",
    "replays": 0,
    "failures": 0
  },
  "target": {
    "vendor_product": "MERIDIAN CoreBank",
    "product_version": "7.4.11",
    "tenant_id": "meridian",
    "entry_point": "http://app:5000/login",
    "surface_kind": "legacy_web"
  },
  "contract": {
    "inputs": [
      {
        "name": "member_id",
        "type": "string",
        "pattern": "^[0-9]{5}$",
        "required": true,
        "sensitivity": "internal",
        "description": "Five-digit member number as printed on the servicing screen.",
        "example": "10001"
      }
    ],
    "outputs": [
      {
        "name": "savings_balance",
        "type": "string",
        "from_step": "s7",
        "sensitivity": "pii",
        "description": "CURRENT BALANCE of the member's SAVINGS sub-account, normalised to a plain decimal string."
      }
    ]
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with that number at this institution.",
      "detect": {
        "kind": "text_present",
        "text": "NO MATCHING MEMBER RECORD FOUND",
        "frame_path": [
          "contentFrame"
        ]
      },
      "terminal": true
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The signed-on operator is not entitled to view this member's record.",
      "detect": {
        "kind": "text_present",
        "text": "YOU ARE NOT AUTHORIZED TO VIEW THIS RECORD",
        "frame_path": [
          "contentFrame"
        ]
      },
      "terminal": true
    }
  ],
  "recoveries": [
    {
      "id": "dismiss_maintenance_notice",
      "description": "The console interposes a maintenance banner at unpredictable times. Known, harmless, and dismissable without changing any state.",
      "when": {
        "kind": "text_present",
        "text": "SYSTEM MAINTENANCE NOTICE"
      },
      "do": "dismiss",
      "max_attempts": 1,
      "target": {
        "primary": {
          "strategy": "a11y_role_name",
          "role": "button",
          "name": "DISMISS",
          "matches_at_record": 1
        },
        "fallbacks": [],
        "recorded": {
          "winning_strategy": "a11y_role_name",
          "candidates_seen": 1,
          "a11y_snippet": "button \"DISMISS\" type=button"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "Open the CoreBank sign-on page",
      "action": "navigate",
      "frame_path": [],
      "value": {
        "literal": "http://app:5000/login"
      },
      "postcondition": {
        "kind": "all_of",
        "conditions": [
          {
            "kind": "url_matches",
            "pattern": "*/login*"
          },
          {
            "kind": "http_ok",
            "at_most": 399
          },
          {
            "kind": "node_present",
            "role": "button",
            "name": "SIGN ON"
          }
        ]
      },
      "risk": "safe_reversible",
      "timing": {
        "observed_ms_p50": 180,
        "timeout_ms": 15000
      }
    },
    {
      "id": "s2",
      "intent": "Enter the service account user id",
      "action": "type",
      "frame_path": [],
      "target": {
        "primary": {
          "strategy": "near_text",
          "role": "textbox",
          "anchor": "USER ID",
          "index": 0,
          "matches_at_record": 1
        },
        "fallbacks": [
          {
            "strategy": "css",
            "value": "#ctl00_txtUserId",
            "matches_at_record": 1
          }
        ],
        "recorded": {
          "winning_strategy": "near_text",
          "candidates_seen": 1,
          "a11y_snippet": "cell \"USER ID\" -> textbox (no accessible name)"
        }
      },
      "value": {
        "secret_ref": "APP_USER"
      },
      "postcondition": {
        "kind": "value_equals",
        "expected": {
