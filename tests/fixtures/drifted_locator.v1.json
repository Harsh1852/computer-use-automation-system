      "intent": "Sign on and load the servicing console",
      "action": "click",
      "frame_path": [],
      "target": {
        "primary": {
          "strategy": "a11y_role_name",
          "role": "button",
          "name": "SIGN ON",
          "matches_at_record": 1
        },
        "fallbacks": [
          {
            "strategy": "css",
            "value": "#ctl00_btnSignOn",
