          "strategy": "near_text",
          "role": "cell",
          "anchor": "SAVINGS",
          "index": 3,
          "matches_at_record": 1
        },
        "fallbacks": [
          {
            "strategy": "xpath",
            "value": "//tr[td[normalize-space()='SAVINGS']]/td[4]",
            "matches_at_record": 1
          }
        ],
        "recorded": {
          "winning_strategy": "near_text",
          "candidates_seen": 1,
          "a11y_snippet": "row \"SAVINGS 10001-S01 PRIMARY SHARE 1,234.56\" -> cell[3]"
